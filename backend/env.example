PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_NAME=zoomtv_db
DB_PORT=3306
# Usa true solo si tu proveedor MySQL exige SSL.
DB_SSL=false

# Gemini (opcional): se usa para redactar respuestas basadas en los datos del chatbot.
# Configúrala solo en backend/.env o en las variables secretas del servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false
